{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "infisical",
    "certificateProfile"
  ],
  "properties": {
    "infisical": {
      "type": "object",
      "required": [
        "url",
        "application",
        "auth"
      ],
      "properties": {
        "url": {
          "type": "string",
          "pattern": "^https?://.+"
        },
        "application": {
          "type": "string",
          "minLength": 1
        },
        "signing": {
          "type": "object",
          "properties": {
            "application": {
              "type": "string"
            }
          }
        },
        "auth": {
          "type": "object",
          "required": [
            "secretName",
            "secretNamespace",
            "clientIdKey",
            "clientSecretKey"
          ],
          "properties": {
            "secretName": {
              "type": "string",
              "minLength": 1
            },
            "secretNamespace": {
              "type": "string",
              "minLength": 1
            },
            "clientIdKey": {
              "type": "string",
              "minLength": 1
            },
            "clientSecretKey": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "certificateProfile": {
      "type": "object",
      "required": [
        "fleet",
        "signing"
      ],
      "properties": {
        "fleet": {
          "type": "string",
          "minLength": 1
        },
        "signing": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
