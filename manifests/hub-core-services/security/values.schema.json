{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "openbao",
    "certificateProfile"
  ],
  "properties": {
    "certificateProfile": {
      "type": "object",
      "required": [
        "fleet",
        "signing"
      ],
      "properties": {
        "fleet": {
          "type": "string",
          "minLength": 1
        },
        "signing": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "openbao": {
      "type": "object",
      "required": [
        "server"
      ],
      "properties": {
        "server": {
          "type": "string",
          "pattern": "^https://.+"
        }
      }
    }
  }
}
